# Nomes das variáveis do .env na VM (/home/opc/agentes-chat/.env, chmod 600). VALORES SÓ NA VM.
# (S) = segredo gerado na VM com openssl; nunca versionar.
COMPOSE_PROJECT_NAME=agentes-chat
NODE_ENV=production
PUBLIC_URL=https://147-15-67-178.sslip.io
DOMAIN=147-15-67-178.sslip.io
COMPOSE_PROFILES=https
AGENTES_IMAGE=ghcr.io/agentes-chat/agentes:0.1.8@sha256:42bc349fa55f89b1d863c62b61f2c228fb80b738e5f237ec9e6b95df0af24bd5
AGENTES_MEMORY=512m
DATABASE_POOL_MAX=5
OUTBOX_MAX_IN_FLIGHT=4
OUTBOX_QUICK_SLOTS=1
OUTBOX_MAX_IN_FLIGHT_CEILING=4
ALLOW_SIGNUP=false
TELEMETRY=off
FEEDBACK_RELAY=false
PROBLEM_REPORT_URL=off
LOG_LEVEL=info
POSTGRES_PASSWORD=(S)
AGENTES_SECRET=(S)
OWNER_CLAIM_SHA256=(S, hash de token de uso único, já consumido)
